# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-key
SUPABASE_BUCKET_NAME=your_bucket_name

# Supabase Postgresql url
DATABASE_URL=postgresql_url

# LLM APIs & STT & TTS
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
SARVAM_API_KEY=your_sarvam_key_here

# Telephony
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_WEBHOOK_BASE_URL=this_deployed_url


# Redis for queue [optional]
REDIS_URL=redis://localhost:6379

# ngrok auth token
NGROK_AUTH_TOKEN=your_auth_token_here
# The tunnel is only opened when this is true (and MODE=development)
ENABLE_NGROK=false

# Env
MODE=development
ENVIRONMENT=development
# HOT-lead RMs, optionally with a WhatsApp number: Asha:+919800000001,Ravi:+919800000002
RM_ROSTER=
